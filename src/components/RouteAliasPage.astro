---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { Button } from '@/components/starwind/button';
import Icon from './icons/Icon.astro';

interface Props {
  title: string;
  description: string;
  h1: string;
  lead: string;
  targetHref: string;
  targetLabel: string;
  breadcrumbLabel: string;
}

const { title, description, h1, lead, targetHref, targetLabel, breadcrumbLabel } = Astro.props;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: breadcrumbLabel, path: Astro.url.pathname },
];
---

<BaseLayout title={title} description={description}>
  <section class="border-b border-border bg-muted/10 py-8 md:py-12">
    <div class="mx-auto max-w-3xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="mt-6 text-2xl font-bold tracking-tight md:text-3xl">{h1}</h1>
      <p class="mt-4 text-sm leading-relaxed text-muted-foreground md:text-base">{lead}</p>
      <div class="mt-8">
        <Button as="a" href={targetHref} variant="primary">
          {targetLabel}
          <Icon name="arrowRight" size={17} />
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
